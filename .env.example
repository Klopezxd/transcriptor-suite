# Hugging Face Access Token (privado para Admin por defecto; requerido para pyannote / diarización de hablantes)
# Obtén tu token con permisos de lectura (Read) en: https://huggingface.co/settings/tokens
# IMPORTANTE: Debes aceptar las condiciones de uso de AMBOS modelos en Hugging Face:
# 1. https://huggingface.co/pyannote/speaker-diarization-3.1
# 2. https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_tu_token_aqui

# Deepgram API Key (privada para Admin; opcional para inferencia ultrarrápida en la nube con Nova-3 / Nova-2)
DEEPGRAM_API_KEY=tu_deepgram_api_key_aqui

# AssemblyAI API Key (privada para Admin; opcional para inferencia de alta fidelidad con assemblyai-stt-3-7 / universal-2)
ASSEMBLYAI_API_KEY=tu_assemblyai_api_key_aqui

# PIN Maestro de Administrador (desbloquea todas las claves privadas del servidor en la app web)
# Recomendado en producción: configura ADMIN_PIN_HASH=scrypt$<salt_hex>$<digest_hex>
# Generación rápida: python -c "from src.utils import hash_admin_pin; print(hash_admin_pin('TU_PIN_SEGURO'))"
ADMIN_PIN=cambia_este_pin_por_un_valor_seguro
